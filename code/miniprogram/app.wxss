page { background: #f5f7f6; color: #18362b; font-family: -apple-system, sans-serif; font-size: 30rpx; }
.container { padding: 32rpx 28rpx 60rpx; }
.title { font-size: 42rpx; font-weight: 650; margin-bottom: 16rpx; }
.hint { color: #63716b; font-size: 26rpx; line-height: 1.7; margin: 12rpx 0 24rpx; }
.card { background: #fff; border: 1rpx solid #dfe8e3; border-radius: 20rpx; padding: 28rpx; margin: 24rpx 0; }
label { display: block; margin: 20rpx 0 10rpx; font-size: 26rpx; }
input { background: #f4f7f5; padding: 20rpx; border-radius: 10rpx; height: 48rpx; color: #18362b; }
button { margin-top: 20rpx; font-size: 28rpx; border-radius: 12rpx; }
.primary { background: #12664d; color: white; }
.error { color: #a13221; line-height: 1.6; position: sticky; top: 0; z-index: 2; background: #fff3ed; border-radius: 12rpx; padding: 16rpx; margin-bottom: 16rpx; }
.amount { font-size: 40rpx; font-weight: 650; padding-top: 20rpx; }
.line { padding: 16rpx 0; border-bottom: 1rpx solid #e9eeeb; line-height: 1.7; }
.section-title { font-size: 32rpx; font-weight: 650; overflow-wrap: anywhere; }
.subtotal { font-weight: 650; margin-top: 18rpx; overflow-wrap: anywhere; }
.product { font-weight: 600; overflow-wrap: anywhere; }
.muted { color: #63716b; font-size: 26rpx; }
.link { color: #12664d; font-weight: 600; margin-top: 20rpx; }
.edit-line { border-top: 1rpx solid #e9eeeb; margin-top: 28rpx; padding-top: 20rpx; }
.field-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0 20rpx; }
.customer-options { display: flex; flex-wrap: wrap; gap: 12rpx; margin: 16rpx 0; }
.customer-options .option { margin: 0; max-width: 100%; overflow-wrap: anywhere; }
.option-active { background: #def2e8; color: #12664d; }
