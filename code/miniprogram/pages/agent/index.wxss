page {
  height: 100%;
  background: var(--canvas);
  color: var(--ink);
  font-size: 30rpx;
}

.agent { display: flex; flex-direction: column; height: 100%; }
.conversation { flex: 1; height: 0; }

.guest-card {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  margin: 32rpx 22rpx;
  padding: 32rpx 28rpx;
}
.guest-card .title { margin-bottom: 0; }
.guest-card .btn-primary, .guest-card .btn-danger-ghost { margin-top: 8rpx; }

.muted { color: var(--ink-3); font-size: 26rpx; line-height: 1.55; }

.turn { display: flex; flex-direction: column; align-items: flex-start; padding: 20rpx 22rpx 0; gap: 12rpx; }
.user-row, .assistant-row { display: flex; align-items: flex-start; gap: 14rpx; width: 100%; }
.user-row { justify-content: flex-end; }
.bubble {
  padding: 18rpx 22rpx;
  border-radius: var(--radius-md);
  box-sizing: border-box;
  white-space: pre-wrap;
  overflow-wrap: anywhere;
}
.user { align-self: flex-end; max-width: 88%; background: var(--primary-weak); color: var(--ink); }
.avatar { width: 54rpx; height: 54rpx; flex: 0 0 54rpx; border-radius: var(--radius-md); line-height: 54rpx; text-align: center; font-weight: 700; }
.mine { color: var(--ink); background: var(--canvas-sub); }
.helper { color: var(--on-primary); background: var(--primary); font-size: 32rpx; }
.assistant-content { flex: 1; min-width: 0; }
.assistant-name, .elapsed { display: block; color: var(--ink-3); font-size: 26rpx; }
.assistant-name { margin-bottom: 6rpx; }
.elapsed { margin-top: 14rpx; }

.card {
  width: 100%;
  padding: 20rpx 22rpx;
  box-sizing: border-box;
  background: var(--surface);
  border: 1rpx solid var(--hairline);
  border-radius: var(--radius-lg);
  white-space: pre-wrap;
  overflow-wrap: anywhere;
}
.starter-card { display: flex; flex-direction: column; gap: 16rpx; margin: 8rpx 0 0; }
.card-title { display: block; font-size: 32rpx; font-weight: 650; line-height: 1.35; }

.draft-inline {
  margin-top: 16rpx;
  background: var(--surface-sunken);
  border: 1rpx solid var(--hairline);
  border-radius: var(--radius-md);
  overflow: hidden;
}
.draft-inline-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  min-height: 80rpx;
  padding: 14rpx 20rpx;
}
.draft-inline-label { flex: 1; min-width: 0; font-weight: 600; overflow-wrap: anywhere; }
.draft-inline-toggle { flex: none; color: var(--primary); font-size: 26rpx; }
.draft-inline-body {
  max-height: 360rpx;
  overflow-y: auto;
  box-sizing: border-box;
  padding: 0 20rpx 16rpx;
  border-top: 1rpx solid var(--hairline);
}
.pending-price { color: var(--warning); font-weight: 500; }

.draft-adopt {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding: 0 20rpx 12rpx;
}
.draft-adopt .draft-adopt-all { flex: none; min-width: 200rpx; }
.price-hint { display: flex; flex-direction: column; gap: 10rpx; padding-bottom: 10rpx; }
.price-options { display: flex; flex-wrap: wrap; gap: 12rpx; }
.price-option { flex: 0 0 auto; min-width: 160rpx; padding: 10rpx 20rpx; }
.preview-hint { display: block; padding-bottom: 8rpx; }
.price-wrap { display: flex; flex: none; flex-wrap: wrap; align-items: baseline; justify-content: flex-end; gap: 8rpx; }
.price-tag, .warn-tag {
  display: inline-flex;
  align-items: center;
  box-sizing: border-box;
  padding: 2rpx 10rpx;
  border-radius: var(--radius-sm);
  font-size: 24rpx;
  line-height: 1.4;
  font-weight: 500;
  white-space: nowrap;
}
.price-tag-history { background: var(--success-weak); color: var(--success); }
.price-tag-catalog { background: var(--canvas-sub); color: var(--ink-2); }
.warn-tag { background: var(--warning-weak); color: var(--warning); }
.catalog-hint { display: block; padding: 4rpx 0 6rpx; }

.card-actions { display: flex; flex-wrap: wrap; gap: 16rpx; margin-top: 20rpx; }
.card-btn-primary, .card-btn-secondary, .card-btn-ghost, .option-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  margin: 0;
  font-size: 30rpx;
  line-height: 1.45;
  border-radius: var(--radius-md);
  transition: background 0.12s ease, color 0.12s ease;
}
.card-btn-primary::after, .card-btn-secondary::after, .card-btn-ghost::after, .option-btn::after { border: 0; }
.card-btn-primary {
  flex: 1 1 100%;
  height: 84rpx;
  background: var(--primary);
  color: var(--on-primary);
  font-weight: 600;
}
.card-btn-primary:active { background: var(--primary-pressed); }
.card-btn-secondary {
  flex: 1 1 calc(50% - 8rpx);
  min-width: 220rpx;
  height: 80rpx;
  background: var(--canvas-sub);
  color: var(--ink);
  font-weight: 500;
}
.card-btn-secondary:active { background: var(--hairline); }
.card-btn-ghost {
  flex: 1 1 calc(50% - 8rpx);
  min-width: 220rpx;
  height: 80rpx;
  background: var(--surface);
  border: 1rpx solid var(--hairline-strong);
  color: var(--ink-2);
  font-weight: 500;
}
.card-btn-ghost:active { background: var(--surface-sunken); }
.option-btn {
  flex: 1 1 auto;
  min-height: 80rpx;
  padding: 12rpx 24rpx;
  background: var(--surface);
  border: 1rpx solid var(--hairline-strong);
  color: var(--ink);
  font-weight: 500;
}
.option-btn:active { background: var(--surface-sunken); }
.option-btn-warn { background: var(--warning-weak); border-color: var(--warning); color: var(--warning); }
.option-btn-warn:active { background: var(--warning-weak); }
.card-btn-primary[disabled], .card-btn-secondary[disabled], .card-btn-ghost[disabled], .option-btn[disabled] {
  color: var(--ink-disabled);
  background: var(--canvas-sub);
  border-color: var(--hairline);
}

.question.detail { padding: 16rpx; border-radius: var(--radius-sm); background: var(--warning-weak); }
.question-item + .question-item { margin-top: 12rpx; }
.actions { display: flex; flex-wrap: wrap; gap: 16rpx; margin-top: 16rpx; }

.choice-list { display: flex; flex-direction: column; gap: 20rpx; margin-top: 16rpx; }
.choice-item {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  padding: 18rpx;
  background: var(--surface-sunken);
  border: 1rpx solid var(--hairline);
  border-radius: var(--radius-md);
}
.choice-item .actions { margin-top: 0; }
.choice-item .card-btn-ghost { flex: none; width: 100%; }
.choice-select {
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  height: 80rpx;
  padding: 0 24rpx;
  background: var(--surface);
  border: 1rpx solid var(--hairline-strong);
  border-radius: var(--radius-md);
  color: var(--ink-2);
  font-size: 30rpx;
  font-weight: 500;
}
.choice-select:active { background: var(--surface-sunken); }
.choice-remember { display: flex; align-items: center; gap: 16rpx; min-height: 80rpx; padding: 4rpx 0; }
.choice-check {
  display: flex;
  flex: none;
  align-items: center;
  justify-content: center;
  width: 40rpx;
  height: 40rpx;
  box-sizing: border-box;
  border: 2rpx solid var(--hairline-strong);
  border-radius: var(--radius-sm);
  background: var(--surface);
  color: var(--on-primary);
  font-size: 26rpx;
  font-weight: 700;
  line-height: 1;
}
.choice-check.checked { background: var(--primary); border-color: var(--primary); }
.choice-remember-text { flex: 1; min-width: 0; color: var(--ink-2); font-size: 30rpx; line-height: 1.45; }

.link-row { display: flex; align-items: center; gap: 16rpx; }
.link-label { flex: 1; min-width: 0; padding-top: 6rpx; overflow-wrap: anywhere; }
.link-row .link-btn { flex: none; min-width: 180rpx; margin-top: 6rpx; }

.preview-line, .file { display: flex; gap: 14rpx; align-items: baseline; }
.preview-line { justify-content: space-between; padding-top: 8rpx; }
.preview-line > text:first-child { flex: 1; min-width: 0; overflow-wrap: anywhere; }
.preview-line > text:last-child { flex: none; }
.amount { color: var(--primary); font-weight: 700; }
.detail { border-top: 1rpx solid var(--hairline); margin-top: 12rpx; padding-top: 12rpx; }
.line, .inline { display: block; padding-top: 6rpx; }

.step { display: flex; align-items: flex-start; gap: 12rpx; padding: 5rpx 0; }
.step-icon { width: 30rpx; height: 30rpx; margin-top: 3rpx; box-sizing: border-box; flex: 0 0 30rpx; text-align: center; line-height: 30rpx; font-weight: 700; color: var(--ink-3); }
.step-text { flex: 1; min-width: 0; }
.step-label { font-size: 30rpx; line-height: 1.5; }
.step-done .step-icon { color: var(--success); }
.step-needs_input .step-icon { color: var(--warning); }
.step-failed .step-icon, .step-failed .step-result { color: var(--danger); }
.step-skipped .step-label { color: var(--ink-3); text-decoration: line-through; }
.step-result { color: var(--ink-3); font-size: 26rpx; padding-left: 8rpx; }
.step-running .step-icon { border: 3rpx solid var(--hairline); border-top-color: var(--primary); border-radius: 50%; animation: roll 0.85s linear infinite; }
@keyframes roll { to { transform: rotate(360deg); } }

.composer {
  flex: none;
  padding: 14rpx 22rpx calc(16rpx + env(safe-area-inset-bottom));
  background: var(--surface);
  border-top: 1rpx solid var(--hairline);
}
.error { display: block; color: var(--danger); margin-bottom: 9rpx; }
.notice { display: block; color: var(--ink-2); font-size: 30rpx; line-height: 1.5; margin-bottom: 9rpx; }
.file-list { max-height: 180rpx; overflow-y: auto; margin-bottom: 8rpx; }
.file { justify-content: space-between; margin-bottom: 8rpx; }
.file-name { flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: 24rpx; }
.file-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
  height: 68rpx;
  margin: 0;
  padding: 0 20rpx;
  background: var(--canvas-sub);
  color: var(--ink);
  border-radius: var(--radius-sm);
  font-size: 26rpx;
  line-height: 1;
}
.file-btn::after { border: 0; }
.file-btn:active { background: var(--hairline); }
.file-btn[disabled] { color: var(--ink-disabled); }

.attachment-row { display: flex; flex-wrap: wrap; gap: 8rpx; margin-bottom: 10rpx; }
.attachment { display: flex; align-items: center; gap: 2rpx; max-width: 100%; padding: 2rpx 4rpx 2rpx 16rpx; background: var(--canvas-sub); border-radius: var(--radius-sm); }
.attachment-name { max-width: 340rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; color: var(--ink-2); font-size: 24rpx; }
.close-button { display: flex; align-items: center; justify-content: center; flex: 0 0 40rpx; width: 40rpx; height: 40rpx; min-height: 0; margin: 0; padding: 0; background: transparent; line-height: 1; }
.close-button::after { border: 0; }
.close-icon { width: 26rpx; height: 26rpx; }
.voice-status { display: block; margin-bottom: 8rpx; padding-left: 4rpx; color: var(--ink-3); font-size: 26rpx; }
.composer-bar { display: flex; align-items: center; gap: 14rpx; }
.image-button { display: flex; align-items: center; justify-content: center; flex: 0 0 88rpx; width: 88rpx; height: 84rpx; margin: 0; padding: 0; background: var(--primary); border-radius: var(--radius-md); box-shadow: var(--shadow-card); line-height: 1; }
.image-button::after { border: 0; }
.image-button[disabled] { opacity: 0.4; background: var(--primary); color: var(--on-primary); }
.image-button-icon { width: 44rpx; height: 44rpx; }
.mode-button { display: flex; align-items: center; justify-content: center; flex: 0 0 72rpx; width: 72rpx; height: 72rpx; margin: 0; padding: 0; background: var(--canvas-sub); border-radius: var(--radius-md); line-height: 1; }
.mode-button::after { border: 0; }
.mode-button:active { background: var(--hairline); }
.mode-icon { width: 36rpx; height: 36rpx; }
.input { flex: 1; min-width: 0; box-sizing: border-box; min-height: 72rpx; max-height: 150rpx; margin: 0; padding: 15rpx 18rpx; background: var(--surface-sunken); border: 1rpx solid var(--hairline); border-radius: var(--radius-md); line-height: 40rpx; font-size: 30rpx; }
.voice-wrap { display: flex; align-items: center; flex: 1; min-width: 0; gap: 10rpx; }
.voice-pad { display: flex; align-items: center; justify-content: center; flex: 1; min-width: 0; height: 72rpx; gap: 12rpx; background: var(--canvas-sub); border: 1rpx solid var(--hairline); border-radius: var(--radius-md); }
.voice-pad.recording { background: var(--danger-weak); border-color: var(--danger); }
.voice-icon { width: 36rpx; height: 36rpx; }
.recording-dot { width: 14rpx; height: 14rpx; background: var(--danger); border-radius: 50%; animation: pulse 1s ease-in-out infinite; }
@keyframes pulse { 0%, 100% { opacity: 1; transform: scale(1); } 50% { opacity: 0.35; transform: scale(0.7); } }
.retry-button { display: flex; align-items: center; justify-content: center; flex: 0 0 60rpx; width: 60rpx; height: 60rpx; margin: 0; padding: 0; background: var(--canvas-sub); border-radius: var(--radius-sm); line-height: 1; }
.retry-button::after { border: 0; }
.retry-icon { width: 32rpx; height: 32rpx; }
.send-button { display: flex; align-items: center; justify-content: center; flex: 0 0 72rpx; width: 72rpx; height: 72rpx; margin: 0; padding: 0; background: var(--hairline); border-radius: 50%; line-height: 1; transition: background 0.15s ease; }
.send-button::after { border: 0; }
.send-button.ready { background: var(--primary); }
.send-button[disabled] { background: var(--hairline); color: var(--ink-disabled); }
.send-button[disabled] .send-icon { opacity: 0.5; }
.send-icon { width: 36rpx; height: 36rpx; }
#latest { height: 20rpx; }
