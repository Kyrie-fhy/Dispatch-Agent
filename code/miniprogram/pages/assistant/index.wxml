<import src="../order-templates.wxml" />
<view class="container">
  <view class="title">整理送货单</view>
  <view wx:if="{{error}}" class="error" role="alert">{{error}}</view>
  <block wx:if="{{loaded}}">
    <block wx:if="{{confirmed}}">
      <view class="card">
        <view class="section-title">已出单 · 第 {{confirmed.version}} 版</view>
        <view class="amount">整趟订单金额 ¥{{confirmed.total}}</view>
        <navigator url="/pages/picking/index" open-type="switchTab" class="link">查看取货清单</navigator>
        <button class="primary" bindtap="nextTrip">开始下一趟</button>
      </view>
      <template is="trip-customers" data="{{summary: confirmed}}" />
    </block>
    <block wx:elif="{{previewTrip}}">
      <view class="section-title">整趟预览</view>
      <template is="trip-customers" data="{{summary: previewTrip}}" />
      <view class="amount">整趟订单金额 ¥{{previewTrip.total}}</view>
      <button class="primary" bindtap="confirmTrip">确认生成正式单</button>
      <button bindtap="backToEdit">返回修改</button>
    </block>
    <block wx:else>
      <view class="card">
        <view class="section-title">本趟客户</view>
        <view class="customer-options">
          <button wx:for="{{draft.customers}}" wx:key="id" data-id="{{item.id}}" bindtap="selectCustomer"
            class="option {{item.id === activeId ? 'option-active' : ''}}">{{index + 1}}. {{item.customer || '未命名客户'}}</button>
        </view>
        <button bindtap="addCustomer">添加客户</button>
      </view>
      <view class="card" wx:if="{{active}}">
        <label for="customer-name">客户名称</label>
        <input id="customer-name" data-id="{{active.id}}" value="{{active.customer}}" bindinput="editCustomer" placeholder="例如：王记餐饮" maxlength="100" />
        <template is="edit-lines" data="{{form: form}}" />
        <button wx:if="{{draft.customers.length > 1}}" bindtap="removeCustomer">移除此客户</button>
      </view>
      <button class="primary" bindtap="showPreview">预览整趟</button>
      <button bindtap="fillSample">填入 A/B/C 验收样例</button>
    </block>
  </block>
  <button bindtap="resetDemo">重置演示数据</button>
</view>
