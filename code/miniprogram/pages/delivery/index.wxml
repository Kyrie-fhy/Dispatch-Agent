<view class="container">
  <view class="title">正式送货单</view>
  <view class="hint">S1 展示已确认订单。配送标记和收款将在 S2、S3 接入。</view>
  <view wx:if="{{error}}" class="error">{{error}}</view>
  <view wx:elif="{{!list.length}}" class="card">还没有正式单，请先到助手录入并确认。</view>
  <view wx:for="{{list}}" wx:key="id" class="card">
    <view>{{item.customer}}</view>
    <view class="hint">{{item.id}}</view>
    <view class="amount">订单金额 ¥{{item.total}}</view>
  </view>
</view>
