@import "../workspace/index.wxss";

.history-back-btn { width: auto; margin: 8rpx 0 20rpx; padding: 0 26rpx; }
.trip-banner { margin: 0 0 8rpx; }
.trip-banner-time { font-size: 34rpx; font-weight: 650; color: var(--ink); }
.trip-banner-meta {
  display: flex;
  flex-wrap: wrap;
  align-items: baseline;
  justify-content: space-between;
  gap: 8rpx 20rpx;
  margin-top: 10rpx;
  font-size: 28rpx;
  color: var(--ink-2);
}

.history-tabs {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 10rpx;
  padding: 8rpx;
  background: var(--canvas-sub);
  border-radius: var(--radius-md);
  margin: 20rpx 0;
}
.history-tab {
  margin: 0;
  height: 76rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  font-weight: 500;
  color: var(--ink-2);
  background: transparent;
  border-radius: var(--radius-sm);
}
.history-tab::after { border: 0; }
.history-tab-active {
  background: var(--surface);
  color: var(--primary);
  font-weight: 650;
  box-shadow: var(--shadow-card);
}

.shop-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  min-height: 116rpx;
  padding: 24rpx 26rpx;
  margin: 16rpx 0;
}
.shop-row:active { background: var(--surface-sunken); }
.shop-main { flex: 1; min-width: 0; }
.shop-title-row { display: flex; flex-wrap: wrap; align-items: center; gap: 12rpx; }
.shop-name { font-size: 34rpx; font-weight: 650; color: var(--ink); }
.shop-meta { font-size: 26rpx; color: var(--ink-3); margin-top: 8rpx; }
.status-tag {
  font-size: 24rpx;
  font-weight: 500;
  padding: 4rpx 14rpx;
  border-radius: var(--radius-sm);
}
.status-done { background: var(--success-weak); color: var(--success); }
.status-pending { background: var(--canvas-sub); color: var(--ink-2); }
.status-unpriced { background: var(--warning-weak); color: var(--warning); }
.shop-right { text-align: right; flex: none; }
.shop-amount-label { font-size: 24rpx; color: var(--ink-3); }
.shop-amount { font-size: 34rpx; font-weight: 700; color: var(--ink); }
.pending-price { color: var(--warning); }
.shop-arrow { font-size: 38rpx; color: var(--ink-3); }
.shop-back-btn { margin: 8rpx 0 20rpx; }

.picking-header {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 16rpx;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid var(--hairline);
}
.picking-count { font-size: 26rpx; color: var(--ink-3); white-space: nowrap; }
.picking-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  min-height: 96rpx;
  padding: 20rpx 0;
}
.picking-row:last-child { border-bottom: 0; padding-bottom: 0; }
.picking-info { min-width: 0; }
.picking-name { font-size: 34rpx; font-weight: 650; color: var(--ink); }
.picking-spec { font-size: 26rpx; color: var(--ink-2); margin-top: 4rpx; }
.picking-quantity { font-size: 40rpx; font-weight: 700; color: var(--primary); white-space: nowrap; }

.turn-block { display: flex; flex-direction: column; gap: 14rpx; margin: 20rpx 0; }
.user-row { display: flex; align-items: flex-start; justify-content: flex-end; gap: 14rpx; }
.user-bubble {
  max-width: 88%;
  padding: 18rpx 22rpx;
  box-sizing: border-box;
  background: var(--primary-weak);
  border-radius: var(--radius-md);
  font-size: 30rpx;
  line-height: 1.6;
  white-space: pre-wrap;
  overflow-wrap: anywhere;
}
.user-text { display: block; }
.user-pictures { display: block; margin-top: 6rpx; color: var(--ink-3); font-size: 26rpx; }
.avatar {
  width: 54rpx;
  height: 54rpx;
  flex: 0 0 54rpx;
  border-radius: var(--radius-md);
  line-height: 54rpx;
  text-align: center;
  font-weight: 700;
}
.avatar.mine { color: var(--ink); background: var(--canvas-sub); }
.avatar.helper { color: var(--on-primary); background: var(--primary); }
.assistant-row { display: flex; align-items: flex-start; gap: 14rpx; }
.assistant-card {
  flex: 1;
  min-width: 0;
  padding: 20rpx 22rpx;
  background: var(--surface);
  border: 1rpx solid var(--hairline);
  border-radius: var(--radius-lg);
  font-size: 30rpx;
  line-height: 1.6;
  overflow-wrap: anywhere;
}
.turn-section + .turn-section, .turn-section + .turn-reply { margin-top: 14rpx; padding-top: 14rpx; border-top: 1rpx solid var(--hairline); }
.turn-label { display: block; font-size: 30rpx; font-weight: 650; color: var(--ink); }
.turn-line { display: block; padding-top: 4rpx; }
.turn-reply { display: block; padding-top: 8rpx; }

.history-item { position: relative; padding: 26rpx 52rpx 26rpx 26rpx; margin: 0 0 18rpx; line-height: 1.65; }
.history-item:active { background: var(--surface-sunken); }
.history-item-head { display: flex; flex-wrap: wrap; align-items: center; gap: 14rpx; }
.history-meta { font-size: 26rpx; color: var(--ink-3); margin-top: 6rpx; }
.history-total { margin-top: 8rpx; font-size: 30rpx; color: var(--ink); }
.history-current {
  background: var(--primary-weak);
  color: var(--primary);
  font-size: 24rpx;
  font-weight: 600;
  padding: 4rpx 14rpx;
  border-radius: var(--radius-sm);
}
.history-item .shop-arrow { position: absolute; right: 20rpx; top: 50%; transform: translateY(-50%); }
