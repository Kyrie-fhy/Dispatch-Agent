.history-page {
  box-sizing: border-box;
  padding: 24rpx var(--page-x) calc(48rpx + env(safe-area-inset-bottom));
}

.empty-title {
  font-size: 34rpx;
  font-weight: 700;
  line-height: 1.35;
  color: var(--ink);
  margin-bottom: 8rpx;
}

/* ---- 往返胶囊 ---- */
.back-bar { margin: 4rpx 0 16rpx; }
.back-pill {
  display: inline-flex;
  align-items: center;
  width: auto;
  height: 80rpx;
  margin: 0;
  padding: 0 26rpx;
  background: var(--surface);
  border: 1rpx solid var(--hairline);
  border-radius: var(--radius-pill);
  font-size: 30rpx;
  font-weight: 600;
  line-height: 1;
  color: var(--ink-2);
  transition: transform var(--dur-press) var(--ease-out), background-color var(--dur-fast) var(--ease-out);
}
.back-pill::after { border: 0; }
.back-pill:active { background: var(--surface-sunken); transform: translateX(-4rpx) scale(0.975); }

/* ---- 第一层 · 趟次列表 ---- */
.trip-card {
  display: flex;
  align-items: center;
  gap: 16rpx;
  min-height: 124rpx;
  padding: 24rpx 26rpx;
  margin: 0 0 18rpx;
  background: var(--surface);
  border: 1rpx solid var(--hairline);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-card);
  transition: transform var(--dur-press) var(--ease-out), background-color var(--dur-fast) var(--ease-out);
  animation: dp-fade-up var(--dur-base) var(--ease-out);
}
.trip-card:active { background: var(--surface-sunken); transform: scale(0.986); }
.trip-card:active .shop-arrow { transform: translateX(4rpx); }
.trip-main { flex: 1; min-width: 0; }
.trip-head { display: flex; flex-wrap: wrap; align-items: center; gap: 12rpx; }
.trip-time {
  font-size: 34rpx;
  font-weight: 700;
  line-height: 1.3;
  color: var(--ink);
}
.trip-meta {
  margin-top: 8rpx;
  font-size: 26rpx;
  line-height: 1.45;
  color: var(--ink-3);
}
.trip-right { flex: none; text-align: right; }
.trip-amount {
  font-size: 36rpx;
  font-weight: 700;
  line-height: 1.2;
  color: var(--ink);
}
.trip-pending {
  margin-top: 4rpx;
  font-size: 24rpx;
  line-height: 1.4;
  color: var(--warning);
}
.btn-secondary.history-more-btn {
  height: 88rpx;
  margin-top: 8rpx;
  background: var(--surface);
  border: 1rpx solid var(--hairline-strong);
}

/* ---- 第二层 · 单趟档案抬头 ---- */
.trip-hero-card {
  margin: 8rpx 0 0;
  padding: 28rpx;
  background: var(--surface);
  border: 1rpx solid var(--hairline);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-card);
  animation: dp-fade-up var(--dur-base) var(--ease-out);
}
.trip-hero-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}
.trip-hero-time {
  min-width: 0;
  font-size: 30rpx;
  font-weight: 650;
  line-height: 1.35;
  color: var(--ink-2);
  overflow-wrap: anywhere;
}
.readonly-tag {
  flex: none;
  padding: 4rpx 14rpx;
  border-radius: var(--radius-sm);
  background: var(--canvas-sub);
  color: var(--ink-3);
  font-size: 24rpx;
  font-weight: 600;
  line-height: 1.3;
  white-space: nowrap;
}
.trip-hero-body {
  display: flex;
  flex-wrap: wrap;
  align-items: flex-end;
  justify-content: space-between;
  gap: 12rpx 20rpx;
  margin-top: 22rpx;
}
.trip-hero-left { min-width: 0; }
.trip-hero-count {
  font-size: 36rpx;
  font-weight: 700;
  line-height: 1.25;
  color: var(--ink);
}
.trip-hero-right { flex: none; text-align: right; }
.trip-hero-amount-label {
  font-size: 26rpx;
  line-height: 1.4;
  color: var(--ink-3);
}
.trip-hero-amount {
  margin-top: 4rpx;
  font-size: 38rpx;
  font-weight: 700;
  line-height: 1.2;
}
.trip-progress-track {
  height: 14rpx;
  margin-top: 22rpx;
  border-radius: 999rpx;
  background: var(--canvas-sub);
  overflow: hidden;
}
.trip-progress-fill {
  height: 100%;
  border-radius: inherit;
  background: var(--primary);
  transition: width 360ms var(--ease-out);
}
.trip-pending-note {
  margin-top: 14rpx;
  font-size: 26rpx;
  line-height: 1.45;
  color: var(--warning);
}

/* ---- 三栏分段胶囊 ---- */
.history-tabs {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 10rpx;
  padding: 8rpx;
  margin: 24rpx 0;
  background: var(--canvas-sub);
  border-radius: var(--radius-md);
}
.history-tab {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 80rpx;
  margin: 0;
  padding: 0;
  background: transparent;
  border-radius: var(--radius-sm);
  font-size: 30rpx;
  font-weight: 500;
  line-height: 1;
  color: var(--ink-2);
  transition: background-color var(--dur-fast) var(--ease-in-out), color var(--dur-fast) var(--ease-in-out), box-shadow var(--dur-fast) var(--ease-in-out), transform var(--dur-press) var(--ease-out);
}
.history-tab::after { border: 0; }
.history-tab:active { transform: scale(0.975); }
.history-tab-active {
  background: var(--surface);
  color: var(--primary);
  font-weight: 650;
  box-shadow: var(--shadow-card);
}

/* ---- 栏一 · 门店列表 ---- */
.shop-card {
  display: flex;
  align-items: center;
  gap: 16rpx;
  min-height: 116rpx;
  padding: 24rpx 26rpx;
  margin: 16rpx 0;
  background: var(--surface);
  border: 1rpx solid var(--hairline);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-card);
  transition: transform var(--dur-press) var(--ease-out), background-color var(--dur-fast) var(--ease-out);
  animation: dp-fade-up var(--dur-base) var(--ease-out);
}
.shop-card:active { background: var(--surface-sunken); transform: scale(0.986); }
.shop-card:active .shop-arrow { transform: translateX(4rpx); }
.shop-card-done {
  background: rgba(255, 255, 255, 0.72);
  border-color: rgba(15, 23, 42, 0.06);
  box-shadow: none;
}
.shop-main { flex: 1; min-width: 0; }
.shop-title-row { display: flex; flex-wrap: wrap; align-items: center; gap: 12rpx; }
.shop-name {
  font-size: 34rpx;
  font-weight: 700;
  line-height: 1.35;
  color: var(--ink);
  overflow-wrap: anywhere;
}
.shop-card-done .shop-name { color: var(--ink-3); }
.shop-meta {
  margin-top: 8rpx;
  font-size: 26rpx;
  line-height: 1.45;
  color: var(--ink-3);
}
.shop-pending { color: var(--warning); }
.shop-right { flex: none; text-align: right; }
.shop-amount {
  font-size: 34rpx;
  font-weight: 700;
  line-height: 1.2;
  color: var(--ink);
}
.shop-card-done .shop-amount { color: var(--ink-2); }
.shop-hint {
  margin-top: 4rpx;
  font-size: 24rpx;
  line-height: 1.4;
  color: var(--ink-3);
}
.shop-arrow {
  flex: none;
  font-size: 38rpx;
  line-height: 1;
  color: var(--ink-3);
  transition: transform var(--dur-press) var(--ease-out);
}

/* ---- 状态胶囊 ---- */
.status-pill {
  flex: none;
  padding: 4rpx 14rpx;
  border-radius: var(--radius-sm);
  font-size: 24rpx;
  font-weight: 600;
  line-height: 1.3;
  white-space: nowrap;
}
.status-done { background: var(--primary-weak); color: var(--primary); }
.status-pending { background: var(--warning-weak); color: var(--warning); }

/* ---- 栏一 · 只读门店详情 ---- */
.sheet-hero-card {
  margin: 8rpx 0 24rpx;
  padding: 28rpx;
  background: var(--surface);
  border: 1rpx solid var(--hairline);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-card);
  animation: dp-fade-up var(--dur-base) var(--ease-out);
}
.sheet-hero-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}
.sheet-shop-name {
  min-width: 0;
  font-size: 42rpx;
  font-weight: 700;
  line-height: 1.2;
  color: var(--ink);
  overflow-wrap: anywhere;
}
.sheet-due-label {
  margin-top: 24rpx;
  font-size: 26rpx;
  line-height: 1.4;
  color: var(--ink-3);
}
.sheet-due-amount {
  margin-top: 4rpx;
  font-size: 58rpx;
  font-weight: 800;
  line-height: 1.15;
  color: var(--ink);
}
.sheet-pending-tip {
  margin-top: 18rpx;
  padding: 12rpx 16rpx;
  background: var(--warning-weak);
  border: 1rpx solid var(--warning-line);
  border-radius: var(--radius-md);
  font-size: 26rpx;
  line-height: 1.45;
  color: var(--warning);
}
.sheet-lines-card {
  margin: 0 0 24rpx;
  padding: 0 28rpx;
  background: var(--surface);
  border: 1rpx solid var(--hairline);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-card);
  animation: dp-fade-up var(--dur-base) var(--ease-out);
}
.sheet-line { border-bottom: 1rpx solid var(--hairline); }
.sheet-line:last-child { border-bottom: 0; }
.sheet-line-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  min-height: 104rpx;
  padding: 22rpx 0;
}
.sheet-line-main { flex: 1; min-width: 0; }
.sheet-line-name {
  font-size: 32rpx;
  font-weight: 650;
  line-height: 1.35;
  color: var(--ink);
  overflow-wrap: anywhere;
}
.sheet-line-meta {
  margin-top: 8rpx;
  font-size: 26rpx;
  line-height: 1.45;
  color: var(--ink-3);
}
.qty-changed { color: var(--warning); font-weight: 700; }
.qty-same { color: var(--ink-2); }
.sheet-line-right { flex: none; text-align: right; }
.sheet-line-subtotal {
  font-size: 32rpx;
  font-weight: 700;
  line-height: 1.3;
  color: var(--ink);
}
.sheet-line-status {
  margin-top: 6rpx;
  font-size: 24rpx;
  line-height: 1.4;
  color: var(--ink-3);
}

/* ---- 栏二 · 冷库取货单 ---- */
.picking-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  margin: 8rpx 0 24rpx;
}
.picking-top-main { min-width: 0; }
.picking-title {
  font-size: 34rpx;
  font-weight: 700;
  line-height: 1.3;
  color: var(--ink);
}
.picking-sub {
  margin-top: 6rpx;
  font-size: 26rpx;
  line-height: 1.45;
  color: var(--ink-3);
}
.picking-count-pill {
  flex: none;
  padding: 12rpx 22rpx;
  background: var(--surface);
  border: 1rpx solid var(--hairline);
  border-radius: var(--radius-pill);
  font-size: 28rpx;
  font-weight: 650;
  color: var(--ink-2);
  white-space: nowrap;
}
.picking-card {
  margin: 24rpx 0;
  padding: 0 28rpx;
  background: var(--surface);
  border: 1rpx solid var(--hairline);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-card);
  animation: dp-fade-up var(--dur-base) var(--ease-out);
}
.picking-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  min-height: 116rpx;
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--hairline);
}
.picking-row:last-child { border-bottom: 0; }
.picking-info { min-width: 0; }
.picking-name {
  font-size: 34rpx;
  font-weight: 700;
  line-height: 1.35;
  color: var(--ink);
  overflow-wrap: anywhere;
}
.picking-spec {
  margin-top: 6rpx;
  font-size: 26rpx;
  line-height: 1.45;
  color: var(--ink-3);
}
.picking-qty-badge {
  display: flex;
  align-items: baseline;
  justify-content: flex-end;
  gap: 8rpx;
  flex: none;
  min-width: 150rpx;
  padding: 12rpx 20rpx;
  border-radius: var(--radius-md);
}
.picking-qty-box { background: var(--primary-weak); color: var(--primary); }
.picking-qty-other { background: var(--canvas-sub); color: var(--ink); }
.picking-qty-num {
  font-size: 48rpx;
  font-weight: 800;
  line-height: 1;
}
.picking-qty-unit {
  font-size: 28rpx;
  font-weight: 700;
}

/* ---- 栏三 · 只读对话回放 ---- */
.turn-block {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
  margin: 20rpx 0;
  animation: dp-fade-up var(--dur-base) var(--ease-out);
}
.user-row {
  display: flex;
  justify-content: flex-end;
}
.user-bubble {
  box-sizing: border-box;
  max-width: 82%;
  padding: 18rpx 24rpx;
  background: var(--primary-weak);
  border: 1rpx solid rgba(15, 110, 82, 0.14);
  border-radius: 28rpx 8rpx 28rpx 28rpx;
  font-size: 30rpx;
  line-height: 1.5;
  color: var(--ink);
  white-space: pre-wrap;
  overflow-wrap: anywhere;
}
.user-text { display: block; }
.user-pictures {
  display: block;
  margin-top: 6rpx;
  font-size: 26rpx;
  color: var(--ink-2);
}
.turn-card {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  padding: 20rpx 24rpx;
  background: var(--surface);
  border: 1rpx solid var(--hairline);
  border-radius: var(--radius-md);
  box-shadow: var(--shadow-card);
  font-size: 30rpx;
  line-height: 1.55;
  overflow-wrap: anywhere;
}
.turn-section {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}
.turn-section + .turn-section,
.turn-section + .turn-reply {
  padding-top: 12rpx;
  border-top: 1rpx solid var(--hairline);
}
.turn-label {
  font-size: 28rpx;
  font-weight: 650;
  line-height: 1.45;
  color: var(--ink-2);
}
.turn-label-muted { color: var(--ink-3); font-weight: 500; }
.turn-line {
  font-size: 30rpx;
  line-height: 1.5;
  color: var(--ink);
}
.turn-preview-pill {
  align-self: flex-start;
  padding: 6rpx 16rpx;
  background: var(--canvas-sub);
  border-radius: var(--radius-sm);
  font-size: 26rpx;
  line-height: 1.4;
  color: var(--ink-2);
}
.turn-questions {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  padding: 14rpx 16rpx;
  background: var(--warning-weak);
  border: 1rpx solid var(--warning-line);
  border-radius: var(--radius-md);
}
.turn-questions .turn-line {
  font-size: 28rpx;
  color: var(--ink-2);
}
.turn-reply {
  font-size: 30rpx;
  line-height: 1.55;
  color: var(--ink);
}

.text-warning { color: var(--warning); }
.text-primary { color: var(--primary); }
