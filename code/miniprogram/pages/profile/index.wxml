<view class="profile">
  <view wx:if="{{error && authGate !== 'activation'}}" class="error">{{error}}</view>

  <block wx:if="{{!signedIn}}">
    <view wx:if="{{authGate === 'activation'}}" class="card gate-card">
      <view class="gate-title">首次使用请输入开通码</view>
      <view class="gate-desc">请输入管理员发来的开通码（如 DZ-XXXX-XXXX），绑定一次后以后直接微信登录</view>
      <input class="gate-input num" value="{{activationCode}}" maxlength="40" placeholder="输入开通码"
        placeholder-class="gate-placeholder" focus="{{true}}" disabled="{{busy}}"
        bindinput="onActivationInput" bindconfirm="submitActivation" />
      <view wx:if="{{error}}" class="gate-error">{{error}}</view>
      <button class="btn-primary gate-btn" loading="{{busy}}" disabled="{{busy}}" bindtap="submitActivation">确认开通</button>
      <button class="btn-ghost gate-btn" disabled="{{busy}}" bindtap="cancelActivation">返回微信登录</button>
    </view>
    <view wx:elif="{{authGate === 'disabled'}}" class="card gate-card gate-card-disabled">
      <view class="gate-badge">账号受限</view>
      <view class="gate-title">当前账号已暂停使用</view>
      <view class="gate-desc">{{disabledMessage || '当前账号已暂停使用，请联系管理员'}}</view>
      <view class="gate-note">管理员在后台恢复启用后，可点击下方按钮重新登录</view>
      <button class="btn-primary gate-btn" loading="{{busy}}" disabled="{{busy}}" bindtap="login">重新登录</button>
    </view>
    <view wx:else class="card account-card">
      <view class="account-title">我的账号</view>
      <view class="hint">微信登录后同步本账号的录单草稿、正式送货单与熟客档案。</view>
      <button wx:if="{{!revokeFailed}}" class="btn-primary" bindtap="login" disabled="{{busy}}">微信登录</button>
      <button wx:else class="btn-danger-ghost account-btn" bindtap="logout" disabled="{{busy}}">重试退出</button>
    </view>
  </block>

  <block wx:else>
    <view class="identity-card">
      <view class="identity-main">
        <view class="identity-dot"></view>
        <view class="identity-text">
          <view class="identity-title">{{remarkName || '微信账号已登录'}}</view>
          <view class="identity-sub">{{remarkName ? '微信账号已登录 · 数据独立同步' : '本账号草稿、正式单与熟客独立同步'}}</view>
        </view>
      </view>
      <view class="identity-tag">已同步</view>
    </view>

    <view class="trip-status-card {{loaded ? 'trip-status-card-link' : ''}}" bindtap="goCurrentStage">
      <view class="trip-status-head">
        <view class="trip-status-dot {{!loaded ? 'dot-idle' : canEditForm ? 'dot-warning' : 'dot-done'}}"></view>
        <view class="trip-status-main">
          <view class="trip-status-label">本趟阶段</view>
          <view class="trip-status-value">{{loaded ? tripMode : '正在同步…'}}</view>
        </view>
        <view wx:if="{{loaded}}" class="trip-status-go">{{canEditForm ? '去录单 ›' : '去送货 ›'}}</view>
      </view>
      <view wx:if="{{tripDetail}}" class="trip-status-detail num">{{tripDetail}}</view>
    </view>

    <view class="metrics-grid">
      <view class="metric-card">
        <view class="metric-label">熟客档案</view>
        <view class="metric-value num">{{partyCount}} 家</view>
        <view class="metric-note">{{loaded ? '已建档熟客' : '正在同步…'}}</view>
      </view>
      <view class="metric-card">
        <view class="metric-label">货品库</view>
        <block wx:if="{{catalogSummary && catalogSummary.productCount > 0}}">
          <view class="metric-value num">{{catalogSummary.productCount}} 种</view>
          <view class="metric-note num">{{catalogSummary.variantCount}} 规格 · 在售 {{catalogSummary.activeVariantCount}}{{catalogSummary.discontinuedVariantCount ? ' · 下架 ' + catalogSummary.discontinuedVariantCount : ''}}</view>
        </block>
        <block wx:elif="{{catalogSummary}}">
          <view class="metric-value metric-value-muted">尚未导入</view>
          <view class="metric-note">导入后自动查表配价</view>
        </block>
        <block wx:elif="{{catalogError}}">
          <view class="metric-value metric-value-warning">读取失败</view>
        </block>
        <block wx:else>
          <view class="metric-value metric-value-idle">正在同步…</view>
        </block>
      </view>
    </view>

    <view wx:if="{{catalogError}}" class="retry-banner error-row">
      <text class="retry-text">{{catalogError}}</text>
      <button class="btn-ghost retry-inline-btn" bindtap="retryLoad" disabled="{{busy}}">重试</button>
    </view>

    <view class="card aliases-card">
      <view class="aliases-head">
        <view class="aliases-title">记住的叫法</view>
        <view wx:if="{{aliasesLoaded && aliases.length}}" class="count-pill num">{{aliases.length}} 条</view>
      </view>
      <view wx:if="{{aliases.length}}" class="alias-list">
        <view wx:for="{{aliases}}" wx:key="alias" class="alias-row">
          <view class="alias-main">
            <text class="alias-name">{{item.alias}}</text>
            <text class="alias-arrow">→</text>
            <text class="alias-canonical">{{item.canonicalName}}</text>
          </view>
          <button class="btn-danger-ghost alias-btn" data-alias="{{item.alias}}" data-name="{{item.canonicalName}}"
            bindtap="unbindAlias" disabled="{{busy}}">解绑</button>
        </view>
      </view>
      <view wx:if="{{aliasError}}" class="retry-banner error-row">
        <text class="retry-text">{{aliasError}}</text>
        <button class="btn-ghost retry-inline-btn" bindtap="retryLoad" disabled="{{busy}}">重试</button>
      </view>
      <view wx:elif="{{aliasesLoaded && !aliases.length}}" class="aliases-empty">录单选店时勾选「记住这个叫法」，就会记在这里。</view>
      <view wx:elif="{{!aliasesLoaded}}" class="aliases-empty">正在同步…</view>
    </view>

    <view wx:if="{{signedIn && !loaded && error}}" class="retry-banner error-row">
      <text class="retry-text">本页信息没加载出来</text>
      <button class="btn-ghost retry-inline-btn" bindtap="retryLoad" disabled="{{busy}}">重试</button>
    </view>

    <view class="action-group">
      <button wx:if="{{canEditForm}}" class="btn-secondary workspace-btn" bindtap="openWorkspace" disabled="{{busy}}">打开表单手动改草稿</button>
      <button class="btn-danger-ghost logout-btn" bindtap="logout" disabled="{{busy}}">退出登录</button>
    </view>
  </block>
</view>
