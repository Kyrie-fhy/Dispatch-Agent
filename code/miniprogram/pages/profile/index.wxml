<view class="profile">
  <view wx:if="{{error}}" class="error">{{error}}</view>

  <view wx:if="{{!signedIn}}" class="card account-card">
    <view class="title">我的账号</view>
    <view class="hint">微信登录后同步本账号的录单草稿、正式送货单与熟客档案。</view>
    <button wx:if="{{!revokeFailed}}" class="btn-primary" bindtap="login" disabled="{{busy}}">微信登录</button>
    <button wx:else class="btn-danger-ghost" bindtap="logout" disabled="{{busy}}">重试退出</button>
  </view>

  <block wx:else>
    <view class="card identity-card">
      <view class="card-title">微信账号已登录</view>
      <view class="status-tag">独立账本已同步</view>
    </view>

    <view class="card overview-card">
      <view class="overview-row">
        <view class="row-label">本趟阶段</view>
        <view class="row-value">
          <view class="row-main">{{loaded ? tripMode : '正在同步…'}}</view>
          <view wx:if="{{tripDetail}}" class="row-detail num">{{tripDetail}}</view>
        </view>
      </view>
      <view class="overview-row">
        <view class="row-label">熟客档案</view>
        <view class="row-value"><text class="num">{{partyCount}} 家</text></view>
      </view>
      <view class="overview-row">
        <view class="row-label">货品库</view>
        <view class="row-value">
          <block wx:if="{{catalogSummary && catalogSummary.productCount > 0}}">
            <view class="row-main num">{{catalogSummary.productCount}} 种</view>
            <view class="row-detail num">{{catalogSummary.variantCount}} 规格 · 在售 {{catalogSummary.activeVariantCount}}{{catalogSummary.discontinuedVariantCount ? ' · 已下架 ' + catalogSummary.discontinuedVariantCount : ''}}</view>
            <view wx:if="{{catalogError}}" class="row-detail">{{catalogError}}</view>
          </block>
          <block wx:elif="{{catalogSummary}}">
            <view class="row-main">尚未导入</view>
            <view wx:if="{{catalogError}}" class="row-detail">{{catalogError}}</view>
          </block>
          <view wx:elif="{{catalogError}}" class="row-main">{{catalogError}}</view>
          <view wx:else class="row-main">正在同步…</view>
        </view>
      </view>
    </view>

    <view class="card aliases-card">
      <view class="card-title">记住的叫法</view>
      <view wx:if="{{aliases.length}}" class="alias-list">
        <view wx:for="{{aliases}}" wx:key="alias" class="alias-row">
          <text class="alias-text">{{item.alias}} → {{item.canonicalName}}</text>
          <button class="btn-danger-ghost alias-btn" data-alias="{{item.alias}}" data-name="{{item.canonicalName}}"
            bindtap="unbindAlias" disabled="{{busy}}">解绑</button>
        </view>
      </view>
      <text wx:if="{{aliasError}}" class="hint">{{aliasError}}</text>
      <text wx:elif="{{aliasesLoaded && !aliases.length}}" class="hint">还没有记住的叫法。录单选店时勾选「记住这个叫法」即可。</text>
      <text wx:elif="{{!aliasesLoaded}}" class="hint">正在同步…</text>
    </view>

    <view class="action-group">
      <button wx:if="{{canEditForm}}" class="btn-secondary" bindtap="openWorkspace" disabled="{{busy}}">打开表单手动改草稿</button>
      <button class="btn-danger-ghost" bindtap="logout" disabled="{{busy}}">退出登录</button>
    </view>
  </block>
</view>
